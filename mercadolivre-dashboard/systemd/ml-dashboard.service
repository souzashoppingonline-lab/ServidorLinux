[Unit]
Description=ML Dashboard — CFO Mercado Livre
Documentation=https://github.com/souzashoppingonline-lab/ServidorLinux
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ml-dashboard
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=10

# Variáveis não-sensíveis inline
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DATA_DIR=/var/lib/ml-dashboard
Environment=ML_REDIRECT_URI=https://multimixvendas.duckdns.org/ml/callback

# Segredos em arquivo separado (NÃO commitado no Git)
# Criar em: /etc/ml-dashboard.env com ML_APP_ID e ML_APP_SECRET
EnvironmentFile=/etc/ml-dashboard.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ml-dashboard

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ml-dashboard

[Install]
WantedBy=multi-user.target

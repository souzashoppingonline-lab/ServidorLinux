# Copie este arquivo para .env e preencha com seus valores reais
# cp .env.example mercadolivre-dashboard/.env

# Credenciais do app Mercado Livre
# Obtenha em: https://developers.mercadolivre.com.br/
ML_APP_ID=SEU_APP_ID_AQUI
ML_APP_SECRET=SEU_APP_SECRET_AQUI

# Porta do servidor (padrão: 3001)
PORT=3001

# Caminho do banco de dados SQLite
DB_PATH=/var/lib/ml-dashboard/ml.db
